{
  // Cloudflare Workers static assets deploy for the Vite build (dist/).
  // The name must match the Worker name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunar-calendar",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths (/day/..., /calendar/...) serve index.html
    // so deep links work instead of returning 404.
    "not_found_handling": "single-page-application"
  }
}
